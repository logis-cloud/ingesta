# Copiar a ingesta-envios/.env

# LOCAL: reemplaza el host por localhost (o el nombre del contenedor
# mongodb-shipments si compartes red docker).
# PRODUCCION: infra.yml genera esto vía UserData con
# ${VMDatabase.PrivateIp}.
MONGO_URI=mongodb://root:root123@localhost:27017/shipments_db?authSource=admin
DB_NAME=shipments_db

S3_BUCKET_NAME=logis-cloud-2026-2
AWS_REGION=us-east-1

INTERVALO_INGESTA=60
RETRY_INGESTA=10
