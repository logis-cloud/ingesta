# Copiar a ingesta-clientes/.env

# LOCAL: si corres mysql-clients del vm-db en tu propia máquina/red
# docker, usa el nombre del contenedor o localhost + el puerto publicado.
# PRODUCCION: no se llena a mano — infra.yml lo genera vía UserData con
# ${VMDatabase.PrivateIp}.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=clients_db

S3_BUCKET_NAME=logis-cloud-2026-2
AWS_REGION=us-east-1

# Segundos entre ciclos cuando el anterior tuvo éxito.
INTERVALO_INGESTA=60
# Segundos antes de reintentar cuando el ciclo anterior falló (BD no
# disponible todavía, tabla no existe, etc.) — no esperes el intervalo
# completo para algo que puede resolverse rápido.
RETRY_INGESTA=10
